{
  "name": "x-md-importer",
  "description": "MarkFlow — 把 Markdown 一键导入 X 文章编辑器，全格式自动排版",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wxt": "^0.19.27"
  }
}
